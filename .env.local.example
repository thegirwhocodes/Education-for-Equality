# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication
# Uses Supabase Auth email/password plus optional magic links. Configure the
# Supabase site URL as https://eduforequality.org and allow local redirect URLs
# only for development.
#
# Google sign-in requires a Google OAuth WEB client configured in Supabase:
# Supabase Dashboard > Authentication > Providers > Google.
# Do not reuse an "installed" Google Calendar/Desktop OAuth client.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Resend email
# Never hardcode a real `re_...` key in source. Store it in local/Vercel env.
# Use a verified Resend domain sender for production.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Education for Equality <no-reply@eduforequality.org>"
RESEND_TEST_TO=you@example.com

# Supabase Auth SMTP via Resend
# Requires SUPABASE_ACCESS_TOKEN in .env.supabase-management.local.
# The app-owned /api/auth/email-link route sends polished user-facing auth
# emails from RESEND_FROM_EMAIL. Supabase SMTP is kept as a fallback; direct
# Supabase SMTP with no-reply@eduforequality.org returned 500 in live smoke.
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=onboarding@resend.dev
SUPABASE_AUTH_SMTP_SENDER_NAME="Education for Equality"
SUPABASE_AUTH_EMAIL_RATE_LIMIT=30

# Advisor board access
# Comma-separated IP allowlist. /advisor-board is also available from these IPs.
ADVISOR_BOARD_ALLOWED_IPS=
# Comma-separated board-account emails. Defaults include Naomi, Sonia, and Richard Ivie.
# Add Remi Tanimola / Richard Odeyemi emails here once confirmed.
BOARD_MEMBER_EMAILS=
NEXT_PUBLIC_BOARD_MEMBER_EMAILS=
# Live Sabi backend used server-side by /advisor-board/sabi-evidence.
SABI_BACKEND_URL=https://api.eduforequality.org
NEXT_PUBLIC_SABI_BACKEND_URL=https://api.eduforequality.org

# Anthropic API Key (for Sabi AI tutor — Claude Haiku, fallback LLM)
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Fast LLM providers for voice calls (optional but highly recommended) ──
# Cerebras: ~2100 tok/s → voice response in ~0.1s (vs ~1s Claude)
# Get from: cloud.cerebras.ai
# Default model gpt-oss-120b (llama-3.3-70b 404s as of Aug 2026).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Groq API Key — used for BOTH Whisper STT (28,800 sec/day free) AND LLM fallback
# Get from: console.groq.com
# Default LLM model openai/gpt-oss-120b (llama-3.3-70b-versatile 404s as of Aug 2026).
# On 429 / empty content the voice path retries openai/gpt-oss-20b (higher free-tier TPM).
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=

# YarnGPT API Key (for Nigerian TTS — free beta, 16 voices)
# Get from: yarngpt.ai account page
# Used after ElevenLabs unless SABI_ELEVENLABS_TTS_ONLY=true.
YARNGPT_API_KEY=

# ElevenLabs API Key (website TTS — Bukola voice; tried before YarnGPT)
# Get from: elevenlabs.io
ELEVENLABS_API_KEY=
# Conversational AI agent ("Education for Equality" in elevenlabs.io/app/conversational-ai)
# Canonical id from project ops logs — use for embed/widget/SDK; Twilio linkage is configured in ConvAI dashboard.
NEXT_PUBLIC_ELEVENLABS_CONVAI_AGENT_ID=agent_5701kp7djbvreqk9cb3mf4g55n09
# Optional: default eleven_flash_v2_5 (Flash / Fastest) — matches ConvAI Bukola sliders
# ELEVENLABS_MODEL_ID=
# ELEVENLABS_VOICE_ID=oC2pCZZWEDRe6lmZpaaw

# Testing — ElevenLabs only for /api/sabi/tts (no YarnGPT fallback). Remove after debugging.
SABI_ELEVENLABS_TTS_ONLY=

# Protects costly Sabi API routes (optional separate key header x-api-key)
SABI_API_KEY=

# Testing — bypasses demo ?key=/cookie gate AND Sabi API auth in middleware (DO NOT use in production)
SABI_OPEN_DEMO=

# Africa's Talking (telephony — ₦3/min incoming)
# Get from: africastalking.com
AT_API_KEY=
AT_USERNAME=
# Optional override. Defaults to sandbox host when AT_USERNAME=sandbox,
# otherwise https://api.africastalking.com/version1/messaging
AT_SMS_BASE_URL=
AT_SENDER_ID=

# Parent/caregiver SMS helper
# Public line shown in texts. For the current flash/callback flow, use the Sabi AT line.
NEXT_PUBLIC_SABI_LINE="+234 201 700 1459"
# Optional shared secret for /api/sabi/sms/incoming. Add it to the AT incoming
# callback URL as ?key=VALUE, or send it as x-sabi-sms-secret.
SABI_SMS_WEBHOOK_SECRET=
# If AT gives us a shared short code + keyword, set the keyword here so inbound
# messages like "SABI HELP" are treated as "HELP".
SABI_SMS_KEYWORD=

# Sabi Demo Key (pre-release access gate — visitors need ?key=VALUE to access /sabi/demo)
SABI_DEMO_KEY=

# App URL (for AT webhook callbacks)
NEXT_PUBLIC_APP_URL=https://eduforequality.org
