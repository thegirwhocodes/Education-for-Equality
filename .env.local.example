# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Clerk Authentication (optional - for user accounts)
# Get these from: clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Anthropic API Key (for Sabi AI tutor — Claude Haiku, fallback LLM)
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Fast LLM providers for voice calls (optional but highly recommended) ──
# Cerebras: ~2100 tok/s → voice response in ~0.1s (vs ~1s Claude)
# Get from: cloud.cerebras.ai
CEREBRAS_API_KEY=

# Groq API Key — used for BOTH Whisper STT (28,800 sec/day free) AND LLM fallback
# Get from: console.groq.com
GROQ_API_KEY=gsk_xxx

# YarnGPT API Key (for Nigerian TTS — free beta, 16 voices)
# Get from: yarngpt.ai account page
# Used after ElevenLabs and Chatterbox unless SABI_ELEVENLABS_TTS_ONLY=true.
YARNGPT_API_KEY=

# ElevenLabs API Key (website TTS — Bukola voice; tried before Chatterbox/YarnGPT)
# Get from: elevenlabs.io
ELEVENLABS_API_KEY=
# Conversational AI agent ("Education for Equality" in elevenlabs.io/app/conversational-ai)
# Canonical id from project ops logs — use for embed/widget/SDK; Twilio linkage is configured in ConvAI dashboard.
NEXT_PUBLIC_ELEVENLABS_CONVAI_AGENT_ID=agent_5701kp7djbvreqk9cb3mf4g55n09
# Optional: default eleven_flash_v2_5 (Flash / Fastest) — matches ConvAI Bukola sliders
# ELEVENLABS_MODEL_ID=
# ELEVENLABS_VOICE_ID=oC2pCZZWEDRe6lmZpaaw

# Testing — ElevenLabs only for /api/sabi/tts (no Chatterbox/YarnGPT fallback). Remove after debugging.
SABI_ELEVENLABS_TTS_ONLY=

# Protects costly Sabi API routes (optional separate key header x-api-key)
SABI_API_KEY=

# Testing — bypasses demo ?key=/cookie gate AND Sabi API auth in middleware (DO NOT use in production)
SABI_OPEN_DEMO=

# Africa's Talking (telephony — ₦3/min incoming)
# Get from: africastalking.com
AT_API_KEY=
AT_USERNAME=

# Sabi Demo Key (pre-release access gate — visitors need ?key=VALUE to access /sabi/demo)
SABI_DEMO_KEY=

# App URL (for AT webhook callbacks)
NEXT_PUBLIC_APP_URL=https://eduforequality.org